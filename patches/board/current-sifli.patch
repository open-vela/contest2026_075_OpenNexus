diff --git a/chips/sf32lb52/sifli_allocateheap.c b/chips/sf32lb52/sifli_allocateheap.c
index 62371c5..23224ee 100644
--- a/chips/sf32lb52/sifli_allocateheap.c
+++ b/chips/sf32lb52/sifli_allocateheap.c
@@ -27,10 +27,12 @@
 #include <nuttx/kmalloc.h>
 
 #include <stdbool.h>
+#include <assert.h>
 
 #include "chip.h"
 #include "arm_internal.h"
 #include "bf0_hal.h"
+#include "mem_map.h"
 
 extern void BSP_PIN_Init(void);
 extern void BSP_Power_Up(bool is_deep_sleep);
@@ -42,9 +44,14 @@ extern void BSP_Board_PreInit(void);
 
 /* SRAM memory configuration for SF32LB52 */
 
-#define SRAM_START  0x20000000
-#define SRAM_SIZE   0x00080000    /* 512 KB */
-#define SRAM_END    (SRAM_START + SRAM_SIZE)
+/* The SDK reserves the top 0x500 bytes for ROM configuration (0x100)
+ * and the HCPU/LCPU mailbox (0x400). They must never be heap memory. */
+#define SRAM_END    (HCPU_RAM_DATA_END_ADDR + 1u)
+
+_Static_assert(SRAM_END <= HCPU_CUSTOM_CONFIG_START_ADDR,
+               "heap overlaps HCPU ROM configuration");
+_Static_assert(SRAM_END <= HPSYS_MBOX_BUF_ADDR,
+               "heap overlaps Bluetooth mailbox");
 
 /* PSRAM memory configuration for SF32LB52 (MPI1 SBUS) */
 
@@ -162,6 +169,7 @@ void up_allocate_heap(FAR void **heap_start, size_t *heap_size)
 {
   /* The heap starts at g_idle_topstack and extends to the end of SRAM */
   
+  DEBUGASSERT(g_idle_topstack < SRAM_END);
   *heap_start = (FAR void *)g_idle_topstack;
   *heap_size  = SRAM_END - g_idle_topstack;
 }
