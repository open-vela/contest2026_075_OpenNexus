+
+static int nuttx_capture_enqueue_buffer(audio_capture_t* cap,
+    struct ap_buffer_s* buffer)
+{
+    struct audio_buf_desc_s desc;
+
+    if (cap->handle.dev.fd < 0 || !buffer) {
+        return -EINVAL;
+    }
+
+    buffer->nbytes = buffer->nmaxbytes;
+    buffer->curbyte = 0;
+    buffer->flags &= ~AUDIO_APB_DEQUEUED;
+
+    memset(&desc, 0, sizeof(desc));
+    desc.numbytes = buffer->nmaxbytes;
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+    desc.session = cap->handle.dev.session;
+#endif
+    desc.u.buffer = buffer;
+
+    if (ioctl(cap->handle.dev.fd, AUDIOIOC_ENQUEUEBUFFER,
+        (uintptr_t)&desc) < 0) {
+        return -errno;
+    }
+
+    return 0;
+}
+
+static void nuttx_capture_cleanup(audio_capture_t* cap)
+{
+    struct audio_msg_s msg;
+    unsigned int prio;
+    int i;
+
+    if (!cap) {
+        return;
+    }
+
+    if (cap->handle.dev.mq != (mqd_t)-1) {
+        if (cap->handle.dev.fd >= 0) {
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+            (void)ioctl(cap->handle.dev.fd, AUDIOIOC_STOP,
+                (uintptr_t)cap->handle.dev.session);
+#else
+            (void)ioctl(cap->handle.dev.fd, AUDIOIOC_STOP, 0);
+#endif
+        }
+
+        for (i = 0; i < CAP_DEVICE_STOP_DRAIN_TRIES; i++) {
+            ssize_t got = mq_receive(cap->handle.dev.mq,
+                (char*)&msg, sizeof(msg), &prio);
+
+            if (got == (ssize_t)sizeof(msg)) {
+                continue;
+            }
+
+            if (got < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+                usleep(10 * 1000);
+                continue;
+            }
+            break;
+        }
+
+        if (cap->handle.dev.fd >= 0) {
+            (void)ioctl(cap->handle.dev.fd, AUDIOIOC_UNREGISTERMQ,
+                (uintptr_t)cap->handle.dev.mq);
+        }
+        (void)mq_close(cap->handle.dev.mq);
+        if (cap->handle.dev.mqname[0] != '\0') {
+            (void)mq_unlink(cap->handle.dev.mqname);
+        }
+        cap->handle.dev.mq = (mqd_t)-1;
+    }
+
+    if (cap->handle.dev.fd >= 0) {
+        if (cap->handle.dev.buffers) {
+            struct audio_buf_desc_s desc;
+
+            for (i = 0; i < cap->handle.dev.nbuffers; i++) {
+                if (!cap->handle.dev.buffers[i]) {
+                    continue;
+                }
+
+                memset(&desc, 0, sizeof(desc));
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+                desc.session = cap->handle.dev.session;
+#endif
+                desc.u.buffer = cap->handle.dev.buffers[i];
+                (void)ioctl(cap->handle.dev.fd, AUDIOIOC_FREEBUFFER,
+                    (uintptr_t)&desc);
+            }
+
+            free(cap->handle.dev.buffers);
+            cap->handle.dev.buffers = NULL;
+            cap->handle.dev.nbuffers = 0;
+        }
+
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+        (void)ioctl(cap->handle.dev.fd, AUDIOIOC_RELEASE,
+            (uintptr_t)cap->handle.dev.session);
+#else
+        (void)ioctl(cap->handle.dev.fd, AUDIOIOC_RELEASE, 0);
+#endif
+        (void)close(cap->handle.dev.fd);
+        cap->handle.dev.fd = -1;
+    }
+
+    cap->handle.dev.current = NULL;
+    cap->handle.dev.current_offset = 0;
+    cap->started = 0;
+}
+
+static int open_nuttx_capture(audio_capture_t* cap, const char* dev_path,
+    unsigned int sample_rate, unsigned int channels,
+    unsigned int bits_per_sample)
+{
+    struct audio_caps_desc_s caps;
+    struct ap_buffer_info_s buf_info;
+    struct audio_buf_desc_s desc;
+    struct mq_attr attr;
+    int ret;
+    int i;
+
+    if (!dev_path || dev_path[0] == '\0') {
+        dev_path = "/dev/audio/pcm0c";
+    }
+
+    if (bits_per_sample != 16 || channels == 0) {
+        return -ENOTSUP;
+    }
+
+    cap->handle.dev.fd = -1;
+    cap->handle.dev.mq = (mqd_t)-1;
+    cap->handle.dev.buffers = NULL;
+    cap->handle.dev.nbuffers = 0;
+    cap->handle.dev.current = NULL;
+    cap->handle.dev.current_offset = 0;
+    cap->handle.dev.abort_requested = 0;
+
+    cap->handle.dev.fd = open(dev_path, O_RDWR | O_CLOEXEC);
+    if (cap->handle.dev.fd < 0) {
+        return -errno;
+    }
+
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+    ret = ioctl(cap->handle.dev.fd, AUDIOIOC_RESERVE,
+        (uintptr_t)&cap->handle.dev.session);
+#else
+    ret = ioctl(cap->handle.dev.fd, AUDIOIOC_RESERVE, 0);
+#endif
+    if (ret < 0) {
+        ret = -errno;
+        goto fail;
+    }
+
+    memset(&caps, 0, sizeof(caps));
+    caps.caps.ac_len = sizeof(struct audio_caps_s);
+    caps.caps.ac_type = AUDIO_TYPE_INPUT;
+    caps.caps.ac_channels = (uint8_t)channels;
+    caps.caps.ac_controls.hw[0] = (uint16_t)sample_rate;
+    caps.caps.ac_controls.b[2] = (uint8_t)bits_per_sample;
+    caps.caps.ac_controls.b[3] = (uint8_t)(sample_rate >> 16);
+    caps.caps.ac_subtype = AUDIO_FMT_PCM;
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+    caps.session = cap->handle.dev.session;
+#endif
+
+    ret = ioctl(cap->handle.dev.fd, AUDIOIOC_CONFIGURE,
+        (uintptr_t)&caps);
+    if (ret < 0) {
+        ret = -errno;
+        goto fail;
+    }
+
+    memset(&buf_info, 0, sizeof(buf_info));
+    if (ioctl(cap->handle.dev.fd, AUDIOIOC_GETBUFFERINFO,
+        (uintptr_t)&buf_info) < 0 || buf_info.nbuffers == 0 ||
+        buf_info.buffer_size == 0) {
+        buf_info.nbuffers = CAP_DEVICE_DEFAULT_BUFFERS;
+        buf_info.buffer_size = CAP_DEVICE_DEFAULT_BUFFER_SIZE;
+    }
+
+    cap->handle.dev.nbuffers = (int)buf_info.nbuffers;
+    cap->handle.dev.buffers = calloc((size_t)cap->handle.dev.nbuffers,
+        sizeof(*cap->handle.dev.buffers));
+    if (!cap->handle.dev.buffers) {
+        ret = -ENOMEM;
+        goto fail;
+    }
+
+    snprintf(cap->handle.dev.mqname, sizeof(cap->handle.dev.mqname),
+        "/fmcap%lx", (unsigned long)(uintptr_t)cap);
+
+    memset(&attr, 0, sizeof(attr));
+    attr.mq_maxmsg = cap->handle.dev.nbuffers + CAP_DEVICE_MQ_EXTRA;
+    attr.mq_msgsize = sizeof(struct audio_msg_s);
+    cap->handle.dev.mq = mq_open(cap->handle.dev.mqname,
+        O_RDWR | O_CREAT | O_NONBLOCK, 0644, &attr);
+    if (cap->handle.dev.mq == (mqd_t)-1) {
+        ret = -errno;
+        goto fail;
+    }
+
+    if (ioctl(cap->handle.dev.fd, AUDIOIOC_REGISTERMQ,
+        (uintptr_t)cap->handle.dev.mq) < 0) {
+        ret = -errno;
+        goto fail;
+    }
+
+    for (i = 0; i < cap->handle.dev.nbuffers; i++) {
+        memset(&desc, 0, sizeof(desc));
+        desc.numbytes = buf_info.buffer_size;
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+        desc.session = cap->handle.dev.session;
+#endif
+        desc.u.pbuffer = &cap->handle.dev.buffers[i];
+
+        ret = ioctl(cap->handle.dev.fd, AUDIOIOC_ALLOCBUFFER,
+            (uintptr_t)&desc);
+        if (ret != (int)sizeof(desc)) {
+            if (ret >= 0) {
+                ret = -EIO;
+            } else {
+                ret = -errno;
+            }
+            goto fail;
+        }
+    }
+
+    cap->backend = AUDIO_CAPTURE_BACKEND_NUTTX_DEVICE;
+    cap->bits_per_sample = bits_per_sample;
+    cap->requested_channels = channels;
+    cap->hw_channels = channels;
+    cap->out_frame_bytes = (bits_per_sample / 8) * channels;
+    cap->hw_frame_bytes = cap->out_frame_bytes;
+
+    syslog(LOG_INFO,
+        "[%s] opened NuttX audio device (%s, %uHz %uch %ubit, %d x %u bytes)\n",
+        TAG, dev_path, sample_rate, channels, bits_per_sample,
+        cap->handle.dev.nbuffers, (unsigned int)buf_info.buffer_size);
+    return 0;
+
+fail:
+    nuttx_capture_cleanup(cap);
+    cap->backend = AUDIO_CAPTURE_BACKEND_NONE;
+    return ret < 0 ? ret : -EIO;
+}
